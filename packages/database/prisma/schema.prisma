generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EngineeringEventType {
  UNKNOWN

  QUEUE_ADDED
  QUEUE_INFRASTRUCTURE_UPDATED

  REDIS_ADDED
  REDIS_INFRASTRUCTURE_ADDED
  REDIS_INFRASTRUCTURE_UPDATED

  DOCKER_ADDED
  DOCKER_INFRASTRUCTURE_CHANGED
  DOCKER_INFRASTRUCTURE_UPDATED

  DATABASE_CHANGE
  DATABASE_SCHEMA_CHANGED
  DATABASE_SCHEMA_UPDATED

  API_ENDPOINT_CHANGED
  AUTH_SYSTEM_CHANGED
  DEPENDENCY_CHANGED
  FRONTEND_UI_CHANGED
  ENGINEERING_EVENT

  PULL_REQUEST
  PR_MERGED
  COMMIT_PUSHED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id        String  @id @default(uuid())
  githubId  String? @unique
  username  String  @unique
  email     String?
  avatarUrl String?

  githubAccessToken String?

  repositories Repository[]

  reports Report[]

    createdTeams Team[] @relation("TeamCreator")

  teamMemberships TeamMember[]

  teamRepositoriesAdded TeamRepository[] @relation("TeamRepositoryAddedBy")
  teamInvitationsReceived TeamInvitation[] @relation("TeamInvitationInvitee")
teamInvitationsSent     TeamInvitation[] @relation("TeamInvitationInvitedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Repository {
  id            String  @id @default(uuid())
  githubRepoId  String?
  name          String
  owner         String
  fullName      String  @unique
  description   String?
  defaultBranch String

  language  String?
  stars     Int     @default(0)
  forks     Int     @default(0)
  isTracked Boolean @default(false)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])

  events              EngineeringEvent[]
  timelineEntries     TimelineEntry[]
  architectureChanges ArchitectureChange[]

    teamRepositories TeamRepository[]

  engineeringRecommendations EngineeringRecommendation[]

  intelligenceSnapshots RepositoryIntelligenceSnapshot[]

  /**
   * Advisor snapshots preserve what ArcHive believed at a particular point in
   * time. This lets future versions explain how architecture risks and
   * recommendations changed as the repository evolved.
   */
  architectureAdvisorSnapshots ArchitectureAdvisorSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamInvitation {
  id String @id @default(uuid())

  teamId String

  invitedById String
  inviteeUserId String

  role TeamMemberRole

  status TeamInvitationStatus @default(PENDING)

  expiresAt DateTime
  acceptedAt DateTime?
  rejectedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

invitedBy User @relation("TeamInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

invitee User @relation("TeamInvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([inviteeUserId])
  @@index([status])
  @@index([expiresAt])
  @@unique([teamId, inviteeUserId, status])
}

model Team {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  createdById String

createdBy User @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Restrict)

  members      TeamMember[]
  repositories TeamRepository[]

  reports Report[]

  invitations TeamInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([createdAt])
}

model TeamMember {
  id     String         @id @default(uuid())
  teamId String
  userId String
  role   TeamMemberRole @default(MEMBER)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

 user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([userId])
  @@index([teamId])
  @@index([teamId, role])
}

model TeamRepository {
  id           String @id @default(uuid())
  teamId       String
  repositoryId String
  addedById    String

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

 addedBy User @relation("TeamRepositoryAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  addedAt DateTime @default(now())

  @@unique([teamId, repositoryId])
  @@index([teamId])
  @@index([repositoryId])
  @@index([addedById])
}

model EngineeringEvent {
  id           String               @id @default(uuid())
  repositoryId String
  eventType    EngineeringEventType
  source       String               @default("github")
  rawPayload   Json
  status       ProcessingStatus     @default(PENDING)
  occurredAt   DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  timelineEntries TimelineEntry[]
}

model TimelineEntry {
  id              String   @id @default(uuid())
  repositoryId    String
  relatedEventId  String?
  title           String
  summary         String
  importanceScore Int      @default(1)
  generatedByAI   Boolean  @default(false)
  createdAt       DateTime @default(now())

  repository   Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  relatedEvent EngineeringEvent? @relation(fields: [relatedEventId], references: [id], onDelete: SetNull)
}

model ArchitectureChange {
  id                 String   @id @default(uuid())
  repositoryId       String
  changeType         String
  detectedTechnology String?
  fileAffected       String?
  summary            String
  createdAt          DateTime @default(now())
  repositoryTypes    String?
  reasoningSignals   String?

  // groups changes into bigger engineering areas
  architectureDomain String?

  // explains how this change contributes to repo evolution
  evolutionSummary String?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

model EngineeringRecommendation {
  id                String    @id @default(uuid())
  repositoryId      String
  recommendationKey String
  title             String
  description       String
  status            String    @default("ACTIVE") // ACTIVE | RESOLVED | DISMISSED
  resolvedAt        DateTime?
  evidence          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, recommendationKey])
}

enum AdminActivityAction {
  REPOSITORY_IMPORTED
  REPOSITORY_REPROCESSED
  REPOSITORY_DELETED
  INTELLIGENCE_REFRESHED
  ENGINEERING_EVENT_PROCESSED
  ARCHITECTURE_CHANGE_DETECTED
  USER_CREATED
  ADMIN_ACTION
}

model AdminActivity {
  id String @id @default(uuid())

  action AdminActivityAction

  actorUserId   String?
  actorUsername String?

  repositoryId       String?
  repositoryName     String?
  repositoryFullName String?

  description String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([action])
  @@index([actorUserId])
  @@index([repositoryId])
  @@index([createdAt])
}

model RepositoryIntelligenceSnapshot {
  id           String @id @default(uuid())
  repositoryId String

  primaryRepositoryType String?

  repositoryTypes     Json
  technologies        Json
  architectureDomains Json
  capabilities        Json
  recommendations     Json
  intelligence        Json

  confidenceScore          Int?
  maturityScore            Int?
  architectureScore        Int?
  capabilityScore          Int?
  engineeringQualityScore  Int?
  productionReadinessScore Int?

  createdAt DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, createdAt])
}

model ArchitectureAdvisorSnapshot {
  id           String @id @default(uuid())
  repositoryId String

  overallAssessment String
  maturityLabel     String

  strengths               Json
  architectureConcerns    Json
  productionRisks         Json
  securityObservations    Json
  scalabilityConcerns     Json
  reliabilityConcerns     Json
  maintainabilityConcerns Json
  observabilityConcerns   Json
  dataConcerns            Json
  deliveryConcerns        Json

  priorityActions      Json
  recommendedNextSteps Json
  evidenceSummary      Json

  overallRiskScore Int
  confidenceScore  Int

  sourceIntelligenceSnapshotId String?

  generatedAt DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId, generatedAt])
  @@index([overallRiskScore])
  @@index([confidenceScore])
}

model Report {
  id          String       @id @default(uuid())

  userId      String?
  teamId      String?

  title       String
  description String?

  status      ReportStatus @default(QUEUED)

  reportData  Json?
  pdfPath     String?
  csvPath     String?
  error       String?

  generatedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([teamId])
  @@index([status])
  @@index([createdAt])
}

enum ArchitectureAdvisorSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ArchitectureAdvisorCategory {
  ARCHITECTURE
  PRODUCTION_READINESS
  SECURITY
  SCALABILITY
  RELIABILITY
  MAINTAINABILITY
  OBSERVABILITY
  DATA
  DELIVERY
  ENGINEERING_QUALITY
}

enum ReportStatus {
  QUEUED
  GENERATING
  COMPLETED
  FAILED
}

enum TeamMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}
