generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EngineeringEventType {
  UNKNOWN

  QUEUE_ADDED
  QUEUE_INFRASTRUCTURE_UPDATED

  REDIS_ADDED
  REDIS_INFRASTRUCTURE_ADDED
  REDIS_INFRASTRUCTURE_UPDATED

  DOCKER_ADDED
  DOCKER_INFRASTRUCTURE_CHANGED
  DOCKER_INFRASTRUCTURE_UPDATED

  DATABASE_CHANGE
  DATABASE_SCHEMA_CHANGED
  DATABASE_SCHEMA_UPDATED

  API_ENDPOINT_CHANGED
  AUTH_SYSTEM_CHANGED
  DEPENDENCY_CHANGED
  FRONTEND_UI_CHANGED
  ENGINEERING_EVENT

  PULL_REQUEST
  PR_MERGED
  COMMIT_PUSHED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id          String   @id @default(uuid())
  githubId    String?  @unique
  username    String   @unique
  email       String?
  avatarUrl   String?

  githubAccessToken String?

  repositories Repository[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Repository {
  id             String   @id @default(uuid())
  githubRepoId   String?
  name           String
  owner          String
  fullName       String   @unique
  description    String?
  defaultBranch  String

  language          String?
  stars             Int        @default(0)
  forks             Int        @default(0)
  isTracked         Boolean    @default(false)
  userId String?
  user   User? @relation(fields: [userId], references: [id])

  events               EngineeringEvent[]
  timelineEntries      TimelineEntry[]
  architectureChanges  ArchitectureChange[]

  engineeringRecommendations EngineeringRecommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EngineeringEvent {
  id           String               @id @default(uuid())
  repositoryId String
  eventType    EngineeringEventType
  source       String               @default("github")
  rawPayload   Json
  status       ProcessingStatus     @default(PENDING)
  occurredAt   DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  timelineEntries TimelineEntry[]
}

model TimelineEntry {
  id              String   @id @default(uuid())
  repositoryId    String
  relatedEventId  String?
  title           String
  summary         String
  importanceScore Int      @default(1)
  generatedByAI   Boolean  @default(false)
  createdAt       DateTime @default(now())

  repository   Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  relatedEvent EngineeringEvent? @relation(fields: [relatedEventId], references: [id], onDelete: SetNull)
}

model ArchitectureChange {
  id                 String   @id @default(uuid())
  repositoryId       String
  changeType         String
  detectedTechnology String?
  fileAffected       String?
  summary            String
  createdAt          DateTime @default(now())
  repositoryTypes String?
  reasoningSignals String?

  // groups changes into bigger engineering areas
  architectureDomain String?

  // explains how this change contributes to repo evolution
  evolutionSummary   String?

  repository Repository @relation(fields: [repositoryId], references: [id])
}

model EngineeringRecommendation {
  id                String   @id @default(uuid())
  repositoryId      String
  recommendationKey String
  title             String
  description       String
  status            String   @default("ACTIVE") // ACTIVE | RESOLVED | DISMISSED
  resolvedAt        DateTime?
  evidence          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id])

  @@unique([repositoryId, recommendationKey])
}