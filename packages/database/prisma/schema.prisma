generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EngineeringEventType {
  PUSH
  PULL_REQUEST
  PR_MERGED
  DEPENDENCY_ADDED
  DOCKER_ADDED
  REDIS_ADDED
  QUEUE_ADDED
  DATABASE_CHANGE
  UNKNOWN
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id          String   @id @default(uuid())
  githubId    String?  @unique
  username    String   @unique
  email       String?
  avatarUrl   String?

  githubAccessToken String?

  repositories Repository[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Repository {
  id             String   @id @default(uuid())
  githubRepoId   String?
  name           String
  owner          String
  fullName       String   @unique
  description    String?
  defaultBranch  String

  userId String?
  user   User? @relation(fields: [userId], references: [id])

  events               EngineeringEvent[]
  timelineEntries      TimelineEntry[]
  architectureChanges  ArchitectureChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EngineeringEvent {
  id           String               @id @default(uuid())
  repositoryId String
  eventType    EngineeringEventType
  source       String               @default("github")
  rawPayload   Json
  status       ProcessingStatus     @default(PENDING)
  occurredAt   DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  timelineEntries TimelineEntry[]
}

model TimelineEntry {
  id              String   @id @default(uuid())
  repositoryId    String
  relatedEventId  String?
  title           String
  summary         String
  importanceScore Int      @default(1)
  generatedByAI   Boolean  @default(false)
  createdAt       DateTime @default(now())

  repository   Repository        @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  relatedEvent EngineeringEvent? @relation(fields: [relatedEventId], references: [id], onDelete: SetNull)
}

model ArchitectureChange {
  id                 String   @id @default(uuid())
  repositoryId       String
  changeType         String
  detectedTechnology String?
  fileAffected       String?
  summary            String
  createdAt          DateTime @default(now())

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}