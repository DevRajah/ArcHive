{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "module": "Node16",
    "moduleResolution": "Node16",

    "declaration": true,
    "sourceMap": true,

    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": false,

    "esModuleInterop": true,

    "types": [
      "node"
    ]
  },

  "include": [
    "src/**/*.ts"
  ],

  "exclude": [
    "dist",
    "node_modules",
    "src/**/__tests__/**",
    "src/**/*.test.ts"
  ]
}