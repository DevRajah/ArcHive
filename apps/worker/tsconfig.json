{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "module": "Node16",
    "moduleResolution": "Node16",

    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": false,

    "esModuleInterop": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}